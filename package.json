{
    "name": "gazi-taoshif-portfolio",
    "private": true,
    "version": "2.0.0",
    "type": "module",
    "scripts": {
        "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"tsx watch server/src/index.ts\"",
        "build": "npm run typecheck && vite build && tsc -p server/tsconfig.json",
        "start": "node server/dist/index.js",
        "lint": "eslint . --max-warnings=0",
        "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
        "test": "node --import tsx --test server/src/**/*.test.ts"
    },
    "dependencies": {
        "@google/generative-ai": "^0.24.1",
        "cors": "^2.8.5",
        "dotenv": "^17.2.2",
        "express": "^5.1.0",
        "express-rate-limit": "^8.1.0",
        "gsap": "^3.13.0",
        "helmet": "^8.1.0",
        "mongoose": "^8.18.0",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "three": "^0.179.1",
        "zod": "^4.1.5"
    },
    "devDependencies": {
        "@eslint/js": "^9.34.0",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.3",
        "@types/node": "^24.3.0",
        "@types/react": "^19.1.12",
        "@types/react-dom": "^19.1.9",
        "@types/three": "^0.179.0",
        "@vitejs/plugin-react": "^5.0.2",
        "concurrently": "^9.2.1",
        "eslint": "^9.34.0",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.20",
        "globals": "^16.3.0",
        "tsx": "^4.20.5",
        "typescript": "~5.8.3",
        "typescript-eslint": "^8.42.0",
        "vite": "^7.1.4"
    }
}